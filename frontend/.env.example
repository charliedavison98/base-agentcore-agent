# Populated automatically by scripts/generate_env.sh for deployments.
# For deployed builds: set to the CloudFront URL (API calls go via /api/* proxy, no CORS).
# For local dev (.env.local): set to the raw API Gateway URL directly.
VITE_API_GATEWAY_URL=
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Local dev: copy to .env.local, fill in values from CDK outputs, then run: npm run dev
